<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Color de fondo -->
    <solid android:color="@android:color/black" />

    <!-- Bordes redondeados -->
    <corners
        android:radius="16dp" /> <!-- Ajusta este valor para cambiar el radio de las esquinas -->

    <!-- Opcional: Padding -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

</shape>