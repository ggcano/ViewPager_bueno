<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Contenido real (inicialmente invisible) -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="invisible">

        <!-- Tu contenido actual aquí (los TextViews y RecyclerView) -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="El tiempo en la zona"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ... resto de tu layout actual ... -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hourlyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            tools:listitem="@layout/item_hourly_weather" />
    </LinearLayout>

    <!-- Layout de Shimmer -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Placeholder para título -->
            <View
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Placeholder para ciudad y temperatura -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="16dp"
                    android:background="#E0E0E0" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:background="#E0E0E0" />
            </LinearLayout>

            <!-- Placeholder para descripción -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Placeholder para línea divisoria -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Placeholder para título de sección -->
            <View
                android:layout_width="200dp"
                android:layout_height="30dp"
                android:layout_marginBottom="16dp"
                android:background="#E0E0E0" />

            <!-- Placeholders para items del RecyclerView -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp"
                android:background="#E0E0E0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp"
                android:background="#E0E0E0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp"
                android:background="#E0E0E0" />

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>